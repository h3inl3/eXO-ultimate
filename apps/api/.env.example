DATABASE_URL=postgres://exo:exo@localhost:5432/exo
PORT=4000
# Dev-only auth: requests send `x-dev-user: <any name>` and act as that (auto-created) user.
# Refused when NODE_ENV=production.
DEV_AUTH=true
# Cognito (stack outputs UserPoolId, WebClientId, MobileClientId, AuthDomain). Optional locally.
# COGNITO_USER_POOL_ID=us-east-2_xxxx
# COGNITO_CLIENT_IDS=<web client id>,<mobile client id>
# COGNITO_DOMAIN=https://exo-ultimate.auth.us-east-2.amazoncognito.com
