{
  "name": "@exo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx src/export-openapi.ts",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@exo/shared": "workspace:*",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "aws-jwt-verify": "^5.2.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
